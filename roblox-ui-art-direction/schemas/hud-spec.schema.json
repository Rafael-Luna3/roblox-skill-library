{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roblox-ui-art-direction/hud-spec.schema.json",
  "title": "HUD Packet (roblox-ui-art-direction)",
  "description": "Versão estruturada mínima de um pacote de HUD (references/hud-delivery-contract.md). Valida consistência documental, NÃO beleza, UX ou responsividade real. As regras cruzadas (IDs referenciados, padrão existente, AssetId fictício, caminhos de captura) são verificadas por scripts/validate_hud_packet.py.",
  "type": "object",
  "required": ["schemaVersion", "packetId", "status", "game", "screen", "phase", "decisions", "layout", "platforms", "inputs", "layers", "components", "states", "assets", "evidence", "manualActions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "packetId": { "type": "string", "pattern": "^HP-[A-Za-z0-9._-]+$" },
    "status": {
      "type": "object",
      "required": ["fictional", "visualVerdict"],
      "additionalProperties": false,
      "properties": {
        "fictional": { "type": "boolean" },
        "visualVerdict": { "enum": ["pendente — sem captura", "aprovado", "aprovado com ressalvas", "reprovado"] },
        "note": { "type": "string" }
      }
    },
    "game": {
      "type": "object",
      "required": ["name", "genre", "visualStyle"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "genre": { "type": "string", "minLength": 1 },
        "visualStyle": { "type": "string", "minLength": 1 }
      }
    },
    "screen": {
      "type": "object",
      "required": ["id", "name", "task", "context", "gameplay", "risk"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "task": { "enum": ["agir", "comparar", "descobrir", "configurar", "acompanhar", "confirmar", "negociar"] },
        "context": { "enum": ["combate", "exploracao", "lobby", "loja", "menu", "social"] },
        "gameplay": { "type": "boolean" },
        "risk": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "phase": { "enum": ["A", "B", "C", "D"] },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["layout", "human", "other"] },
          "summary": { "type": "string", "minLength": 1 },
          "status": { "enum": ["decidido", "pendente", "aprovado", "rejeitado"] },
          "path": { "type": "string" }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["decisionId", "pattern", "rejected"],
      "additionalProperties": false,
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "pattern": { "type": "string", "pattern": "^[a-z]+\\.[a-z-]+$" },
        "rejected": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["pattern", "reason"],
            "additionalProperties": false,
            "properties": { "pattern": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "supported"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["desktop", "ultrawide", "phone-portrait", "phone-landscape", "tablet", "console-tv"] },
          "supported": { "type": "boolean" },
          "composition": { "type": "string" },
          "reflowTrigger": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["mouseKeyboard", "touch", "gamepad"],
      "additionalProperties": false,
      "properties": {
        "mouseKeyboard": { "type": "boolean" },
        "touch": { "type": "boolean" },
        "gamepad": { "type": "boolean" }
      }
    },
    "focus": {
      "type": "object",
      "required": ["initial", "back", "route"],
      "additionalProperties": false,
      "properties": {
        "initial": { "$ref": "#/$defs/id" },
        "back": { "type": "string", "minLength": 1 },
        "route": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 }
      }
    },
    "protectedZones": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["screenGui", "layer", "displayOrder", "screenInsets"],
        "additionalProperties": false,
        "properties": {
          "screenGui": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["GameplayHUD", "Contextual", "Menu", "Modal", "CriticalOverlay"] },
          "displayOrder": { "type": "integer" },
          "screenInsets": { "enum": ["CoreUISafeInsets", "DeviceSafeInsets", "TopbarSafeInsets", "None"] }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "role", "states"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["Panel", "Button", "IconButton", "Tab", "ItemCard", "CurrencyPill", "ProgressBar", "Modal", "Sheet", "Tooltip", "Toast", "FocusRing", "EmptyState", "LoadingSkeleton", "ErrorState", "ConfirmationFooter", "Custom"] },
          "role": { "type": "string", "minLength": 1 },
          "assets": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "states": { "type": "array", "items": { "enum": ["idle", "hover", "press", "selected", "focus", "disabled", "pending", "success", "error"] } },
          "contract": { "type": "string" }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "applicable"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "applicable": { "type": "boolean" },
          "reason": { "type": "string" },
          "text": { "type": "string" },
          "action": { "type": "string" },
          "recovery": { "type": "string" },
          "captureRequired": { "type": "boolean" },
          "capture": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string", "minLength": 1 }, "date": { "type": "string" } }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancel": { "type": "string" },
        "recovery": { "type": "string" },
        "errorHandling": { "type": "string" },
        "confirmation": { "type": "string" },
        "serverAuthority": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "robloxAssetId", "fallback"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["planned", "prompt-ready", "generated", "approved", "prepared", "uploaded", "rejected", "pending"] },
          "robloxAssetId": { "type": ["string", "null"] },
          "fallback": { "type": "string", "minLength": 1 },
          "localPath": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "claim", "source", "date", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["official", "observed", "heuristic", "hypothesis", "human-decision", "qa-capture"] },
          "claim": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "confidence": { "enum": ["alta", "média", "baixa", "nenhuma"] },
          "path": { "type": "string" }
        }
      }
    },
    "manualActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "action": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "blocks": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "screen": { "properties": { "gameplay": { "const": true } } } } },
      "then": { "required": ["protectedZones"], "properties": { "protectedZones": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "inputs": { "properties": { "gamepad": { "const": true } } } } },
      "then": { "required": ["focus"] }
    },
    {
      "if": { "properties": { "screen": { "properties": { "risk": { "enum": ["high", "critical"] } } } } },
      "then": { "required": ["risk"], "properties": { "risk": { "required": ["cancel", "recovery", "errorHandling", "confirmation", "serverAuthority"] } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
  }
}
